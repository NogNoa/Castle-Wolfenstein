readm.doc:
    put dos 2.1 boot diskette (disk1) in drive A:
    put backup disk (bk) in drive B:
        format /s B:
        diskcopy A: B:
    put supplemental dos diskette (disk2) in drive A:
        COPY DEBUG.COM B:
    put game diskette (cw) in drive A:
        COPY FIXIT.BAT B:
        COPY INP*. B:
    move bk to drive A:
        a:fixit

debug<inp1:
    l 100 0 5 1     load a:5..6 to ds:100
    e 12b           enter 20 to ds:12b
    20              
    w 100 0 5 1     write ds:100 to a:5..6
    q               quit debug

